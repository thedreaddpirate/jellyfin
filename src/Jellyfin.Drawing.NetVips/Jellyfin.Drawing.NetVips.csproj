<Project Sdk="Microsoft.NET.Sdk">

  <!-- ProjectGuid is only included as a requirement for SonarQube analysis -->
  <PropertyGroup>
    <ProjectGuid>{3B1C8D77-9B4E-4E6E-9E9B-6C4B2F1A5D30}</ProjectGuid>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\SharedVersion.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BlurHashSharp" />
    <PackageReference Include="NetVips" />
  </ItemGroup>

  <!--
    The prebuilt libvips binaries are shipped as one NuGet package per runtime identifier, each
    carrying a single self-contained shared library - libjpeg, libpng, libwebp, libheif and librsvg
    are statically linked into it, so nothing has to be installed on the host. At ~18MB apiece,
    referencing every RID would add hundreds of megabytes to a plain `dotnet build`, so only the one
    matching the RID being built for is pulled in. A build with no RID has no target to narrow to and
    falls back to the two platforms we publish. `-p:JellyfinNetVipsNativeAssets=false` drops all of
    them when the host is expected to provide a system libvips instead.

    A RID with no package here is not an error: nothing ships, ModuleInitializer.VipsInitialized
    stays false, and CoreAppHost falls back to SkiaEncoder.
  -->
  <PropertyGroup>
    <JellyfinNetVipsNativeAssets Condition=" '$(JellyfinNetVipsNativeAssets)' == '' ">true</JellyfinNetVipsNativeAssets>
  </PropertyGroup>

  <ItemGroup Condition=" '$(JellyfinNetVipsNativeAssets)' == 'true' ">
    <PackageReference Include="NetVips.Native.linux-x64" Condition=" '$(RuntimeIdentifier)' == 'linux-x64' or '$(RuntimeIdentifier)' == '' " />
    <PackageReference Include="NetVips.Native.linux-arm64" Condition=" '$(RuntimeIdentifier)' == 'linux-arm64' or '$(RuntimeIdentifier)' == '' " />
    <PackageReference Include="NetVips.Native.linux-arm" Condition=" '$(RuntimeIdentifier)' == 'linux-arm' " />
    <PackageReference Include="NetVips.Native.linux-musl-x64" Condition=" '$(RuntimeIdentifier)' == 'linux-musl-x64' " />
    <PackageReference Include="NetVips.Native.linux-musl-arm64" Condition=" '$(RuntimeIdentifier)' == 'linux-musl-arm64' " />
    <PackageReference Include="NetVips.Native.win-x64" Condition=" '$(RuntimeIdentifier)' == 'win-x64' " />
    <PackageReference Include="NetVips.Native.win-arm64" Condition=" '$(RuntimeIdentifier)' == 'win-arm64' " />
    <PackageReference Include="NetVips.Native.osx-x64" Condition=" '$(RuntimeIdentifier)' == 'osx-x64' " />
    <PackageReference Include="NetVips.Native.osx-arm64" Condition=" '$(RuntimeIdentifier)' == 'osx-arm64' " />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\MediaBrowser.Model\MediaBrowser.Model.csproj" />
    <ProjectReference Include="..\..\MediaBrowser.Controller\MediaBrowser.Controller.csproj" />
    <ProjectReference Include="..\..\MediaBrowser.Common\MediaBrowser.Common.csproj" />
  </ItemGroup>

</Project>
